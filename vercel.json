{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node scripts/build-components.js",
  "outputDirectory": ".",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.burza-mozgow-korepetycje.pl"
        }
      ],
      "destination": "https://burza-mozgow-korepetycje.pl/:path*",
      "permanent": true
    },
    {
      "source": "/angielski-dla-doroslych-wyszkow",
      "destination": "/angielski-dla-doroslych",
      "permanent": true
    },
    {
      "source": "/angielski-dla-mlodziezy",
      "destination": "/angielski-dla-dzieci",
      "permanent": true
    },
    {
      "source": "/korepetycje-jablonna",
      "destination": "/jablonna",
      "permanent": true
    },
    {
      "source": "/korepetycje-matematyka-jablonna",
      "destination": "/jablonna#matematyka",
      "permanent": true
    },
    {
      "source": "/korepetycje-polski-jablonna",
      "destination": "/jablonna#polski",
      "permanent": true
    },
    {
      "source": "/kurs-angielski-jablonna",
      "destination": "/jablonna/angielski",
      "permanent": true
    },
    {
      "source": "/kursy-maturalne-jablonna",
      "destination": "/jablonna/kursy-maturalne-e8",
      "permanent": true
    },
    {
      "source": "/lokalizacja-zegrzynska-22-jablonna",
      "destination": "/jablonna",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, s-maxage=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/upload/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, s-maxage=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
